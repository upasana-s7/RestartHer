{
  "name": "RestartHER",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-restarther": "cds watch --open restarther.restarther/index.html?sap-ui-xx-viewCache=false --livereload false",
    "frontend:dev": "npm run dev --workspace app/frontend",
    "frontend:build": "npm run build --workspace app/frontend",
    "frontend:typecheck": "npm run typecheck --workspace app/frontend"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/restarther"
  ]
}
